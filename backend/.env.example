# 复制本文件为 .env 并填入真实密钥（.env 已被 gitignore，不会进仓库）
# Render 线上请在服务 Environment 里配置 DEEPSEEK_API_KEY，环境变量优先于 .env
DEEPSEEK_API_KEY=

# 本地静态页的缺省来源；生产必须改为实际 HTTPS 前端来源，逗号分隔，不使用 *。
# 同源部署不需要跨域；CORS 不是身份认证，不能替代限流。
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# 仅在确有该可信反向代理时填写；这里的地址仅是本机代理示例，不是生产推荐值。
# 必须在 uvicorn 启动前设置为进程环境变量，或用 --forwarded-allow-ips 显式传入。
# main.py 导入时加载本 .env 的时机可能晚于 uvicorn 解析代理配置。
# 填实际可信代理 IP/网段（逗号分隔），禁止 *；直连无代理可传空列表。
# 代理须清洗/正确追加客户端地址，后端只使用 uvicorn 处理后的 request.client.host。
FORWARDED_ALLOW_IPS=127.0.0.1